#!/bin/sh
set -eu

script_path=$0
while [ -L "$script_path" ]; do
  link_target=$(readlink "$script_path")
  case "$link_target" in
    /*) script_path=$link_target ;;
    *) script_path=$(dirname -- "$script_path")/$link_target ;;
  esac
done
runtime_root=$(CDPATH= cd -- "$(dirname -- "$script_path")/.." && pwd)
af_version_output=$(af --version)
case "$af_version_output" in
  "agent-fixes "*) af_version=${af_version_output#agent-fixes } ;;
  *)
    echo "af-onboard-safe: could not parse the installed AF version: $af_version_output" >&2
    exit 1
    ;;
esac
case "$af_version" in
  ""|*[!0-9A-Za-z._-]*)
    echo "af-onboard-safe: invalid installed AF version token: $af_version" >&2
    exit 1
    ;;
esac
cache_file="$runtime_root/resources/af-onboard/$af_version.md"

if [ ! -f "$cache_file" ]; then
  echo "af-onboard-safe: no exact onboarding cache for AF $af_version" >&2
  echo "Refresh the version-pinned cache outside the sandbox before continuing." >&2
  exit 1
fi

exec /bin/cat "$cache_file"
